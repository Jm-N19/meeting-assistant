# ============ 服务器 ============
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=info

# ============ LLM: DeepSeek ============
# https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
# 可选: deepseek-chat (V3, 默认) / deepseek-reasoner (R1)
DEEPSEEK_MODEL=deepseek-chat

# ============ 语音转写: WhisperX / pyannote ============
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=zh
# 用于 pyannote 说话人分割模型的 HuggingFace token (需要先在 HF 上同意协议)
HF_TOKEN=

# ============ 集成: Jira Cloud ============
JIRA_SERVER=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MEET

# ============ 集成: 飞书 Open API ============
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=

# ============ 集成: SMTP 邮件 ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============ 向量库: Chroma ============
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION=meetings
